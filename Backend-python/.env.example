# HEAL Clinic — FastAPI Backend Configuration
APP_NAME=HEAL Clinic Management API
APP_ENV=development
DEBUG=True
PORT=8000

# Database Connection
# SQLite (Default for instant zero-config setup):
DATABASE_URL=sqlite:///./heal.db

# For MySQL in production (uncomment and replace credentials):
# DATABASE_URL=mysql+pymysql://heal_user:your_password@localhost:3306/heal_clinic_db?charset=utf8mb4

# Security / JWT
JWT_SECRET=HEAL_SECURE_JWT_SECRET_KEY_CHANGE_IN_PRODUCTION_2026!@#
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173","*"]

# File Uploads
UPLOAD_DIR=./uploads/photos
MAX_UPLOAD_SIZE_MB=10
